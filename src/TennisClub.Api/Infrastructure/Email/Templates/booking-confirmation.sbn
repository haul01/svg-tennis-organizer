<!DOCTYPE html>
<html lang="de">
<head><meta charset="UTF-8"></head>
<body style="font-family: Arial, sans-serif; color: #0b1c30; line-height: 1.6;">
  <h1 style="color: #0a192f;">Buchungsbestätigung</h1>

  <p>Hallo {{ first_name }},</p>

  <p>deine Reservierung ist bestätigt:</p>

  <table style="border-collapse: collapse; margin: 20px 0;">
    <tr>
      <td style="padding: 8px 16px 8px 0;"><strong>Platz:</strong></td>
      <td style="padding: 8px 0;">{{ court_name }}</td>
    </tr>
    <tr>
      <td style="padding: 8px 16px 8px 0;"><strong>Datum:</strong></td>
      <td style="padding: 8px 0;">{{ date_label }}</td>
    </tr>
    <tr>
      <td style="padding: 8px 16px 8px 0;"><strong>Uhrzeit:</strong></td>
      <td style="padding: 8px 0;">{{ time_label }}</td>
    </tr>
    {{ if has_guest }}
    <tr>
      <td style="padding: 8px 16px 8px 0;"><strong>Gastspieler:</strong></td>
      <td style="padding: 8px 0;">{{ if guest_name }}{{ guest_name }}{{ else }}vermerkt{{ end }}</td>
    </tr>
    {{ end }}
  </table>

  {{ if has_guest }}
  <p style="background: #fff4e5; border-left: 3px solid #d97706;
            padding: 12px 16px; color: #7c2d12;">
    <em>Bitte vergiss nicht, die Gastspielergebühr im Vereinsheim zu entrichten.</em>
  </p>
  {{ end }}

  <p style="color: #44474d; font-size: 14px;">
    Stornierung möglich unter „Meine Buchungen" in der App.
  </p>

  <p style="margin-top: 32px;">Sportliche Grüße<br>Dein SVG Tennis</p>
</body>
</html>
