# Copy to deploy/.env on the Pi and fill in real values.
# Never commit the real .env (it's in .gitignore via the .env pattern).

# Postgres password for the runtime user.
DB_PASSWORD=change_me

# Random >=32 chars for JWT signing.
# Generate via: openssl rand -base64 48
JWT_SIGNING_KEY=change_me_to_a_random_48_char_secret

# First admin account created by the seed on initial DB boot.
# After first login this user can manage members in the admin UI.
ADMIN_EMAIL=admin@example.at
ADMIN_PASSWORD=change_me_too

# Public URL the frontend is reachable at (used in welcome /
# password-reset links).
FRONTEND_BASE_URL=https://tennis.example.at

# Initial season seeded on first boot. Existing seasons are not
# overwritten so editing this later has no effect on the running app.
SEASON_NAME=Sommersaison 2026
SEASON_START=2026-04-01
SEASON_END=2026-10-31
SEASON_OPENING=08:00:00
SEASON_CLOSING=22:00:00
SEASON_SLOT_MINUTES=60
